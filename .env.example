# Aftab Clinic - Firebase Cloud Environment Configuration
# Copy this file to .env to connect your live Firebase project

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=aftab-clinic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aftab-clinic
VITE_FIREBASE_STORAGE_BUCKET=aftab-clinic.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
